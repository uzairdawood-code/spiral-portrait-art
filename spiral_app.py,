import math
import tkinter as tk
from PIL import Image

# Configuration
IMAGE_NAME = "image_2d82c0.jpg"  # Your image file
WIDTH, HEIGHT = 800, 800

class SimpleSpiralApp:
    def __init__(self, root, image_path):
        self.root = root
        self.root.title("Sundas's Spiral Animation")
        self.root.geometry(f"{WIDTH}x{HEIGHT}")
        self.root.configure(bg="black")

        # Create canvas
        self.canvas = tk.Canvas(root, width=WIDTH, height=HEIGHT, bg="black", highlightthickness=0)
        self.canvas.pack(fill=tk.BOTH, expand=True)

        # Load image and convert to grayscale for brightness mapping
        try:
            img = Image.open(image_path).convert("L")
            img = img.resize((WIDTH, HEIGHT), Image.Resampling.LANCZOS)
            self.image_data = img.load()
        except Exception as e:
            print(f"Could not load image: {e}")
            self.image_data = None

        # Spiral math settings
        self.max_theta = 45 * 2 * math.pi
        self.current_theta = 0.0
        self.step = 0.4

        # Run the animation loop
        self.draw_frame()

    def draw_frame(self):
        if self.current_theta < self.max_theta and self.image_data:
            batch_limit = min(self.current_theta + 20.0, self.max_theta)
            cx, cy = WIDTH / 2, HEIGHT / 2

            while self.current_theta < batch_limit:
                # Archimedean spiral formula
                a = 2.5
                r = a * self.current_theta
                
                x = cx + r * math.cos(self.current_theta)
                y = cy + r * math.sin(self.current_theta)

                if 0 <= int(x) < WIDTH and 0 <= int(y) < HEIGHT:
                    brightness = self.image_data[int(x), int(y)]
                    if brightness < 200:  # Draw dots where the image has dark features/details
                        size = max(1, int((255 - brightness) / 70))
                        self.canvas.create_oval(x, y, x + size, y + size, fill="white", outline="")

                self.current_theta += self.step

            # Speed of animation frames
            self.root.after(5, self.draw_frame)

if __name__ == "__main__":
    root = tk.Tk()
    app = SimpleSpiralApp(root, IMAGE_NAME)
    root.mainloop()